# ── Trusted sources ─────────────────────────────────────────────
# Document index pages the fetcher is allowed to scrape, comma-separated.
# Only PDFs whose links resolve to TRUSTED_PDF_HOSTS are downloaded.
TRUSTED_SOURCE_URLS=https://antikorupsi.org/en/dokumen,https://antikorupsi.org/en/category/trends,https://antikorupsi.org/id/dokumen
TRUSTED_PDF_HOSTS=antikorupsi.org,www.antikorupsi.org

# ── Parser agent (LLM) ──────────────────────────────────────────
# OpenAI-compatible endpoint used by the extract step.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o

# ── Site ────────────────────────────────────────────────────────
PUBLIC_SITE_NAME=The Ledger of Stolen Money
